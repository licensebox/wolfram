Get[FileNameJoin[{DirectoryName[DirectoryName[$InputFileName]],"Kernel","Licensebox.wl"}]];
assert[condition_,description_String]:=If[!TrueQ[condition],Print["FAIL: ",description];Exit[1]];
base=<|"product"->"demo","keys"-><|"test-key"->"A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg"|>,"server"->Environment["LICENSEBOX_CALLBACK_SERVER"]|>;
binding="m1:linux-machine-id:783b8906a4af61095e68f3f0b4468a953be69ddd7afcf35850b501a7361f309e";
common=<|"clock"->Function[1700000000.],"machine_binding"->Function[binding]|>;
folder=Environment["LICENSEBOX_CALLBACK_DIRECTORY"];
callbacks=0;
options=Join[base,<|"directory"->FileNameJoin[{folder,"throw"}]|>];
c=LicenseboxOpen[options,Join[common,<|"on_sign_in"->Function[{url,code},callbacks++;Throw["expected callback failure"]]|>]];
assert[AssociationQ[c]&&JLink`JavaObjectQ[c["Object"]],"actual sign-in callback client"];
result=LicenseboxSignIn[c,1.];
assert[MatchQ[result,Failure["callback_error",_Association]]&&callbacks===1,"throwing sign-in callback must fail safely"];
LicenseboxClose[c];
assert[!FileExistsQ[FileNameJoin[{folder,"throw","lease"}]],"failed callback must not persist authorization"];
cancel=False;callbacks=0;
options=Join[base,<|"directory"->FileNameJoin[{folder,"cancel"}]|>];
c=LicenseboxOpen[options,Join[common,<|"on_sign_in"->Function[{url,code},callbacks++;cancel=True],"cancelled"->Function[cancel]|>]];
assert[AssociationQ[c]&&JLink`JavaObjectQ[c["Object"]],"actual cancellation callback client"];
result=LicenseboxSignIn[c,1.];
assert[MatchQ[result,Failure["cancelled",_Association]]&&callbacks===1,"cancellation must stop actual activation"];
LicenseboxClose[c];
assert[!FileExistsQ[FileNameJoin[{folder,"cancel","lease"}]],"cancelled activation must not persist authorization"];
Print["PASS: actual Wolfram sign-in callback exceptions and post-notification cancellation"];
