package=Environment["LICENSEBOX_PACKAGE_DIR"];
If[!StringQ[package]||!DirectoryQ[package],Print["FAIL: missing installed package"];Exit[1]];
Get[FileNameJoin[{package,"Kernel","Licensebox.wl"}]];
assert[condition_,description_String]:=If[!TrueQ[condition],Print["FAIL: ",description];Exit[1]];
assert[ExpandFileName[FileNameJoin[{Licensebox`Private`$root,"Kernel","Licensebox.wl"}]]===ExpandFileName[FileNameJoin[{package,"Kernel","Licensebox.wl"}]],"consumer must load installed Wolfram code"];
vectors=Import[Environment["LICENSEBOX_VECTORS"],"RawJSON"];
assert[AssociationQ[vectors],"consumer requires actual public fixtures"];
lease=LicenseboxVerifyLease[vectors["valid_lease"],vectors["product"],vectors["keys"],vectors["now"]];
assert[AssociationQ[lease]&&MemberQ[lease["modules"],"core"],"installed consumer must verify real signed lease"];
assert[MatchQ[LicenseboxVerifyLease[vectors["valid_lease"],vectors["product"],<||>,vectors["now"]],Failure[_,_Association]],"installed consumer must reject untrusted keys"];
identifier="12345678123456789abc1234567890ab";
expected="m1:linux-machine-id:783b8906a4af61095e68f3f0b4468a953be69ddd7afcf35850b501a7361f309e";
assert[LicenseboxDeriveBinding["demo","linux-machine-id",identifier]===expected,"installed native binding derivation"];
assert[LicenseboxDeriveBinding["demo","linux-machine-id",identifier<>FromCharacterCode[0]]===expected,"terminal NUL normalization"];
assert[MatchQ[LicenseboxDeriveBinding["demo","linux-machine-id",identifier<>FromCharacterCode[0]<>"suffix"],Failure["identity_unavailable",_Association]],"embedded NUL rejection"];
native=LicenseboxNativeBinding["demo"];assert[StringQ[native]&&StringStartsQ[native,"m1:"],"installed native identity helper"];
c=LicenseboxOpen[<|"product"->"demo","keys"->vectors["keys"],"directory"->FileNameJoin[{package,"consumer-state"}]|>];
assert[AssociationQ[c]&&JLink`JavaObjectQ[c["Object"]],"installed consumer must create real native client"];
status=LicenseboxStatus[c];assert[FailureQ[status]&&status[[1]]==="not_signed_in","fresh installed status must refuse access"];
heartbeat=LicenseboxHeartbeat[c,"core"];assert[MatchQ[heartbeat,Failure["not_signed_in",_Association]],"installed explicit heartbeat must refuse a missing lease without activation"];
LicenseboxClose[c];LicenseboxClose[c];
assert[MatchQ[LicenseboxHeartbeat[c,"core"],Failure["closed",_Association]],"closed installed heartbeat must refuse access"];
assert[MatchQ[LicenseboxStatus[c],Failure["closed",_Association]],"closed installed client must refuse access"];
Print["PASS: actual Wolfram installed-package consumer, real signatures, native helpers and lifecycle"];
